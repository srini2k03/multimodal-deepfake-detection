# API settings as environment variables (DFD_<SECTION>__<KEY> overrides configs/*.yaml).
# No secrets are needed: the project uses no external APIs.

# Serve the released benchmark models (run scripts/fetch_weights.py first)
DFD_CONFIG=configs/serve.yaml
DFD_API__WEIGHTS_DIR=weights

# Upload limits and abuse protection
DFD_API__MAX_UPLOAD_MB=100
DFD_API__MAX_VIDEO_SECONDS=300
DFD_API__MAX_AUDIO_SECONDS=600
DFD_API__RATE_LIMIT_PER_MINUTE=20
DFD_API__CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Audio longer than this is truncated before scoring
DFD_AUDIO__MAX_SECONDS=120

# Logging: JSON lines by default; media content and uploaded file names are never logged
DFD_LOG_LEVEL=INFO
DFD_LOG_JSON=1

# gunicorn
PORT=5000
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
