# Base URL of the API when the UI is served separately from the backend.
# Leave empty to use same-origin /api (dev proxy or nginx in Docker).
VITE_API_BASE=

# Static browser demo (used by `npm run build:pages`, see .env.pages):
# VITE_DEMO=browser                      run the preprocessing pipeline client-side, placeholder scores
# VITE_BASE=/multimodal-deepfake-detection/   base path when hosted under a sub-path
# VITE_MEDIAPIPE_CDN=                    override the pinned jsDelivr URL for @mediapipe/tasks-vision
